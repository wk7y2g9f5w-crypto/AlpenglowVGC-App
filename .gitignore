# Flutter
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
.dart_tool/
# Python
.venv/
api/.venv/
api/__pycache__/
**/__pycache__/
*.pyc
# Env / secrets
.env
*.key

# CI secrets (distribution private key, p12 password) - never commit
.ci/

# Bot runtime artifacts
bot/*.db
bot/*.log
bot/*.pid
bot/seed/*.db

# Realistic hole-map pipeline intermediates (derived OSM vectors — never commit).
# Only rendered images + pipeline code + generated manifest are committed.
tools/hole-maps/data/

# PWA: Flutter web build output staged for FastAPI static serving (built at
# deploy time by tools/build_pwa.sh, never committed)
api/static_web/
